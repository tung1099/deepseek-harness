{
  "name": "dsh-financial-analyst",
  "version": "0.1.0",
  "description": "DeepSeek Harness financial-statement analyst preset: sourced ratios (P/E, ROE, margins, debt to equity), peer comparison, anomaly screening, and an HTML report with charts. Presents data only and never recommends buying or selling",
  "type": "module",
  "exports": {
    "./tools": "./tools.js",
    "./skills": "./skills.js",
    "./package.json": "./package.json"
  },
  "files": ["data.js", "deliver.js", "lookup.js", "summary.js", "metrics.js", "anomalies.js", "analyze.js", "report.js", "tools.js", "skills.js", "skills", "cordis.patch.yml", "README.md"],
  "scripts": {
    "test": "node --test \"tests/*.test.js\""
  },
  "engines": {
    "dsh": ">=0.2.2-alpha.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
